rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Farmer Crops & Harvest Registry
    match /crops/{cropId} {
      allow read, write: if true;
    }

    // 3. Mandi Inventory Batches
    match /mandi_inventory/{batchId} {
      allow read, write: if true;
    }

    // 4. Wholesaler Inventory Batches
    match /wholesaler_inventory/{batchId} {
      allow read, write: if true;
    }

    // 5. Generic Inventory Batches
    match /inventory/{batchId} {
      allow read, write: if true;
    }

    // 6. Anonymized B2B Surplus Marketplace
    match /surplus_listings/{listingId} {
      allow read, write: if true;
    }

    // 7. Supply Chain Orders & Escrow Transactions
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 8. Live & Historical Mandi Market Price Cache
    match /mandi_prices/{priceId} {
      allow read, write: if true;
    }

    // 9. 10-Layer AI Pipeline Logs & Telemetry
    match /pipeline_logs/{logId} {
      allow read, write: if true;
    }

    // Fallback for all other development/hackathon collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
