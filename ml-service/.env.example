# Service Port & Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Government of India Mandi Live Data API (data.gov.in)
DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Live Weather Telemetry (OpenWeatherMap / WeatherAPI)
WEATHER_API_KEY=YOUR_WEATHER_API_KEY

# Model Pipeline Settings
MODEL_DIR=app/trained_models
DATA_DIR=data

# -----------------------------------------------------------------
# 4. Groq Free AI Cloud API (Llama 3.3 70B Versatile)
# Register for free at: https://console.groq.com/keys
# -----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
