# =================================================================
# PeriX Unified Master Environment Configuration Template
# Copy this file to .env and insert your API keys
# =================================================================

# Server & Common Ports
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Frontend Next.js Public Variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_ML_URL=http://localhost:8000/api

# Firebase Web Client Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.web.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Backend NestJS Endpoints
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Government Mandi Live Data API (data.gov.in)
DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Live Weather Telemetry (OpenWeatherMap / WeatherAPI)
WEATHER_API_KEY=YOUR_WEATHER_API_KEY

# ML Microservice Pipeline Settings
MODEL_DIR=app/trained_models
DATA_DIR=data
AUTO_RETRAIN_INTERVAL_HOURS=24
MAPE_THRESHOLD_PCT=12.0
